<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The golden test alone, in its own project so it runs in a fresh test process, as the capture did. On .NET
         Framework, 1.0.2's request heads after the dropped-connection case depend on what the process did before:
         with other network tests earlier in the same run, "Proxy-Connection: Keep-Alive" went missing from two
         recorded cases (2026-09-27). -->
    <!-- net48 runs the library's net462 build (Windows only); net10.0 runs the net10.0 build everywhere. -->
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <!-- The capture's files (linked below) were written without F# nullness and call the obsolete IsImageUrl on
         purpose (FS0044); they are frozen, so the project adapts to them, never the other way round. -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);44</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- The golden capture's own files, compiled unchanged against the new library (frozen since 57cf1aa). -->
    <Compile Include="../Golden/Capture/Json.fs" Link="Golden/Json.fs" />
    <Compile Include="../Golden/Capture/FixtureServer.fs" Link="Golden/FixtureServer.fs" />
    <Compile Include="../Golden/Capture/Cases.fs" Link="Golden/Cases.fs" />
    <Compile Include="GoldenTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Golden/1.0.2.*.json" Link="Golden/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="6.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IsImageUrlDotNet/IsImageUrlDotNet.fsproj" />
  </ItemGroup>

</Project>
