<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Golden capture of the PUBLISHED IsImageUrlDotNet 1.0.2 (package-modernize, Phase 0), adapted from the skill's
    scripts/golden-capture-nuget.template.cs into F#. 1.0.2 ships only lib/net45, which .NET 10 also loads (NU1701),
    so the capture runs on both runtimes a caller can have: net10.0 and net48 (.NET Framework, Windows).
    Run from this folder:  dotnet run -c Release -f net10.0 > ../1.0.2.net10.0-linux.json
    The Directory.Build.* and Directory.Packages.props files beside this one are empty on purpose: they stop MSBuild
    from importing the repository's own props, so later changes to the repository cannot change this recording.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- 1.0.2 is a net45 package; a net10.0 app restores it through the .NET Framework fallback on purpose. -->
    <NoWarn>$(NoWarn);NU1701;SYSLIB0014</NoWarn>
    <!-- FSharp.Core pinned, not the SDK's implicit version (which follows the SDK's feature band). -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="FixtureServer.fs" />
    <Compile Include="Cases.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IsImageUrlDotNet" Version="[1.0.2]" />
    <PackageReference Include="FSharp.Core" Version="[10.1.401]" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
