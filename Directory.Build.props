<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- packages.lock.json per project; CI restores in locked mode so the cache key is stable. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <!-- Source Link, symbols and a deterministic build for the packed project. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- A new advisory in a test or build package warns locally; the CI audit step (AuditPipeline) fails on it. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <WarningsAsErrors Condition="'$(AuditPipeline)' == 'true'">$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- F#: FSharp.Core is pinned in each project, never the SDK's implicit version (it follows the SDK's feature band).
       Warnings 1182 (unused values) and 3390 (malformed XML doc) are off by default; turn them on. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- F# adds System.ValueTuple to .NET Framework builds by default; nothing here uses struct tuples. -->
    <DisableImplicitSystemValueTupleReference>true</DisableImplicitSystemValueTupleReference>
    <OtherFlags>$(OtherFlags) --warnon:1182,3390</OtherFlags>
  </PropertyGroup>

  <!-- C# (the extension-form tests): the .NET analyzers apply to C# only. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
